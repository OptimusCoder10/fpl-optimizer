# Backend
DATABASE_URL=
# Same database, direct or session-mode endpoint; never a transaction pooler.
SESSION_DATABASE_URL=
# Optional additional trusted PEM CA; omit to use the system trust store.
DATABASE_SSL_CA_FILE=
TEST_DATABASE_URL=postgresql+asyncpg://fpl_optimizer:fpl_optimizer_test@127.0.0.1:5433/fpl_optimizer_test
FRONTEND_ORIGIN=

# Frontend - public browser configuration, not a secret
NEXT_PUBLIC_API_BASE_URL=

# Manual FPL ingestion; set the season/rules namespace explicitly before running.
# FPL_SEASON_ID=2026-27
# FPL_RULES_VERSION=fpl-2026-v1
FPL_RUN_BUDGET_SECONDS=660
FPL_HISTORY_BUDGET_SECONDS=600

# Optional raw shared-snapshot archive. Keep FPL_STORAGE_KEY in platform secrets.
# Configure all four names together before enabling archive capture.
# FPL_STORAGE_URL=
# FPL_STORAGE_KEY=
# FPL_STORAGE_BUCKET=
# FPL_STORAGE_ALLOWANCE_BYTES=
